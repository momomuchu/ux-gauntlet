{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ux-gauntlet/schemas/tasks.schema.json",
  "title": "UX Gauntlet happy-path task list",
  "type": "object",
  "required": ["goal", "steps"],
  "properties": {
    "goal": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "$ref": "#/$defs/step" }
        ]
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "target": { "type": "string" },
        "action": { "type": "string" },
        "audited_terminal_step": { "type": "boolean" },
        "external_side_effect": { "type": "boolean" },
        "precondition_step": { "type": "boolean" },
        "payment_step": { "type": "boolean" },
        "denylist_override": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
