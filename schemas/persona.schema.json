{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ux-gauntlet/schemas/persona.schema.json",
  "title": "UX Gauntlet persona",
  "type": "object",
  "required": [
    "goal",
    "success_criteria",
    "budget_authority",
    "patience_threshold_steps",
    "forbidden_claims"
  ],
  "properties": {
    "name": { "type": "string" },
    "goal": { "type": "string", "minLength": 1 },
    "success_criteria": { "type": "string", "minLength": 1 },
    "budget_authority": { "type": "string", "minLength": 1 },
    "patience_threshold_steps": { "type": "integer", "minimum": 1 },
    "forbidden_claims": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "additionalProperties": true
}
